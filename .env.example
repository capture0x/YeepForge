# YeepForge Environment Configuration
# Copy this file to .env and fill in your values

# === ENGAGEMENT ===
TARGET_URL=https://target.example.com
ENGAGEMENT_NAME=MyPentestEngagement

# === AUTHENTICATION ===
COOKIES=sessionid=abc123; csrftoken=xyz789
AUTH_TOKEN=Bearer eyJhbGci...
WEB_USERNAME=admin
WEB_PASSWORD=

# === PROXY ===
PROXY=http://127.0.0.1:8080

# === AI AGENT ===
ANTHROPIC_API_KEY=sk-ant-...

# === OUTPUT ===
OUTPUT_DIR=output

# === OPTIONS ===
YEEPFORGE_SHOW_SECRETS=false
